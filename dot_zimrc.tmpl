# vim: set filetype=zsh:
###############################################################################
# User configuration sourced by interactive shells
###############################################################################

# ------------------------------
# Modules
# ------------------------------

zmodule environment
zmodule input
zmodule joke/zim-mise
zmodule termtitle
zmodule utility

zmodule z-shell/zsh-eza --if-command eza
zmodule joke/zim-chezmoi --if-command chezmoi
zmodule kiesman99/zim-zoxide --if-command zoxide
zmodule shanwker1223/zim-alias-finder

zmodule fzf --if-command fzf

# ------------------------------
# Prompt
# ------------------------------

zmodule joke/zim-starship --if-command starship

# ------------------------------
# Completion
# ------------------------------

zmodule zsh-users/zsh-completions --fpath src
zmodule gradle/gradle-completion --fpath . --if-command gradle

zmodule completion

# ------------------------------
# Modules that must be initialized last
# ------------------------------

zmodule zsh-users/zsh-syntax-highlighting
zmodule zsh-users/zsh-history-substring-search
zmodule zsh-users/zsh-autosuggestions
